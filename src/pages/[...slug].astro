---
import { getCollection, render } from 'astro:content';
import Base from '../layouts/Base.astro';
import Life from '../components/Life.astro';
export async function getStaticPaths() {
  return (await getCollection('entries')).map((entry) => ({
    params: { slug: entry.data.permalink ?? `entries/${entry.id}` },
    props: { entry },
  }));
}
const { entry } = Astro.props;
const { Content } = await render(entry);
---

<Base title={entry.data.title} description={entry.data.description}>
  <article>
    <header class="page-heading article-heading">
      <a class="back-link" href="/">
        ← All entries
      </a>
      <h1>{entry.data.title}</h1>
      <div class="article-meta">
        <time datetime={entry.data.date.toISOString()}>
          {entry.data.date.toLocaleDateString('en-GB', {
            day: 'numeric',
            month: 'long',
            year: 'numeric',
            timeZone: 'UTC',
          })}
        </time>
        <a href={`/?type=${entry.data.type}`}>{entry.data.type}</a>
        {entry.data.status && <span class="tag">{entry.data.status}</span>}
      </div>
    </header>
    {entry.data.cover && (
      <img
        class="game-cover"
        src={entry.data.cover}
        alt={`${entry.data.title} preview`}
      />
    )}
    {entry.data.interactive === 'game-of-life' && <Life />}
    {entry.data.playUrl && (
      <>
        <iframe
          class="game-frame"
          src={entry.data.playUrl}
          title={`Play ${entry.data.title}`}
          allow="fullscreen; gamepad"
          loading="lazy"
        ></iframe>
        <p>
          <a
            class="button"
            href={entry.data.playUrl}
            target="_blank"
            rel="noopener"
          >
            Open in its own tab ↗
          </a>
        </p>
      </>
    )}
    {entry.data.externalUrl && (
      <p>
        <a class="button" href={entry.data.externalUrl}>
          Play or download ↗
        </a>
      </p>
    )}
    {entry.data.controls && (
      <p>
        <strong>Controls:</strong> {entry.data.controls}
      </p>
    )}
    <div class="prose">
      <Content />
    </div>
  </article>
</Base>
